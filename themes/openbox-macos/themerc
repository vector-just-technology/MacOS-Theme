# ── MacOS 26.1 Openbox Window Decoration Theme ──────────────
# Matches WhiteSur-Light GTK appearance

# Border
border.width: 1
border.color: #d5d5d5

# Window padding
padding.width: 6
padding.height: 4

# Title bar
window.active.title.bg: Solid Flat
window.active.title.bg.color: #ececec
window.active.title.border.color: #d0d0d0

window.inactive.title.bg: Solid Flat
window.inactive.title.bg.color: #f5f5f5
window.inactive.title.border.color: #e0e0e0

# Title text
window.active.label.text.color: #1a1a1a
window.active.label.bg: Parentrelative
window.inactive.label.text.color: #888888
window.inactive.label.bg: Parentrelative

window.label.text.justify: Center

# Handle (resize grip)
window.active.handle.bg: Solid Flat
window.active.handle.bg.color: #d5d5d5
window.active.grip.bg: Solid Flat
window.active.grip.bg.color: #b0b0b0
window.inactive.handle.bg: Solid Flat
window.inactive.handle.bg.color: #e8e8e8
window.inactive.grip.bg: Solid Flat
window.inactive.grip.bg.color: #cccccc
window.handle.width: 4
window.grip.width: 16

# ── Traffic light buttons (macOS close/min/max) ─────────────

# Close button — red
window.active.button.close.bg: Solid Flat
window.active.button.close.bg.color: #ff5f57
window.active.button.close.image.color: #ff5f57
window.active.button.close.pressed.bg: Solid Flat
window.active.button.close.pressed.bg.color: #cc4b43

window.inactive.button.close.bg: Solid Flat
window.inactive.button.close.bg.color: #d0d0d0
window.inactive.button.close.image.color: #d0d0d0

# Iconify (minimise) — yellow
window.active.button.iconify.bg: Solid Flat
window.active.button.iconify.bg.color: #febc2e
window.active.button.iconify.image.color: #febc2e
window.active.button.iconify.pressed.bg: Solid Flat
window.active.button.iconify.pressed.bg.color: #cc9920

window.inactive.button.iconify.bg: Solid Flat
window.inactive.button.iconify.bg.color: #d0d0d0
window.inactive.button.iconify.image.color: #d0d0d0

# Maximise — green
window.active.button.max.bg: Solid Flat
window.active.button.max.bg.color: #28c840
window.active.button.max.image.color: #28c840
window.active.button.max.pressed.bg: Solid Flat
window.active.button.max.pressed.bg.color: #1fa030
window.active.button.max.toggled.bg: Solid Flat
window.active.button.max.toggled.bg.color: #28c840

window.inactive.button.max.bg: Solid Flat
window.inactive.button.max.bg.color: #d0d0d0
window.inactive.button.max.image.color: #d0d0d0

# All other buttons
window.active.button.*.bg: Solid Flat
window.active.button.*.bg.color: #d0d0d0
window.inactive.button.*.bg: Solid Flat
window.inactive.button.*.bg.color: #e8e8e8

# ── Font ─────────────────────────────────────────────────────
window.active.label.text.font: Inter:bold:pixelsize=12
window.inactive.label.text.font: Inter:normal:pixelsize=12

# ── Menu ─────────────────────────────────────────────────────
menu.title.bg: Solid Flat
menu.title.bg.color: #ececec
menu.title.text.color: #1a1a1a
menu.title.text.font: Inter:bold:pixelsize=11
menu.title.border.color: #d0d0d0

menu.items.bg: Solid Flat
menu.items.bg.color: #f8f8f8
menu.items.text.color: #1a1a1a
menu.items.disabled.text.color: #aaaaaa

menu.items.active.bg: Solid Flat
menu.items.active.bg.color: #0071e3
menu.items.active.text.color: #ffffff
menu.items.active.disabled.text.color: #88bbee

menu.border.color: #d0d0d0
menu.border.width: 1
menu.overlap.x: -1
menu.overlap.y: 0
menu.separator.color: #d0d0d0
menu.separator.width: 1
menu.separator.padding.width: 4
menu.separator.padding.height: 2
